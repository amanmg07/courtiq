# Copy to .env and adjust as needed.

# PostgreSQL
POSTGRES_USER=courtiq
POSTGRES_PASSWORD=courtiq_dev_password
POSTGRES_DB=courtiq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy connection string (built from the above if you use docker-compose;
# for local Homebrew Postgres this is set directly by scripts/setup_db.sh)
DATABASE_URL=postgresql+psycopg://courtiq:courtiq_dev_password@localhost:5432/courtiq

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
